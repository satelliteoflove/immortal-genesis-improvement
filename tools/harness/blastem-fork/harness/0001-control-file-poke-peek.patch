+// Run control commands from a file, one a line, so a headless run needs no socket.
+void ctrl_fifo_run_file(const char *path)
+{
+	char line[1024];
+	FILE *f = fopen(path, "r");
+	if (!f) {
+		warning("ctrl_sock: can't open %s\n", path);
+		return;
+	}
+	while (fgets(line, sizeof(line), f)) {
+		line[strcspn(line, "\r\n")] = 0;
+		process_command(line);
+	}
+	fclose(f);
+}
+
 static void ctrl_sock_init(void)
 {
 	const char *path = getenv("BLASTEM_CTRL_SOCK");
