+// Work RAM is held as 16-bit words; an even 68000 address is the high byte.
+static uint8_t ram_byte(uint32_t addr, int write, uint8_t value)
+{
+	if (!current_system || current_system->type != SYSTEM_GENESIS) {
+		return 0;
+	}
+	uint16_t *word = ((genesis_context *)current_system)->work_ram + ((addr & 0xFFFF) >> 1);
+	int shift = addr & 1 ? 0 : 8;
+	if (write) {
+		*word = (*word & ~(0xFF << shift)) | value << shift;
+	}
+	return *word >> shift;
+}
+
 static void apply_action(kit_action *a, uint32_t target)
 {
 	char line[512];
 	switch (a->kind)
 	{
+	case KS_POKE:
+		ram_byte(a->count, 1, (uint8_t)a->buttons);
+		snprintf(line, sizeof(line), "KIT SCRIPT frame=%u at=%u poke %06x %02x",
+			script_frame_now, target, a->count, a->buttons);
+		break;
+	case KS_PEEK:
+		snprintf(line, sizeof(line), "KIT SCRIPT frame=%u at=%u peek %06x %02x",
+			script_frame_now, target, a->count, ram_byte(a->count, 0, 0));
+		break;
 	case KS_DOWN:
 	case KS_UP:
 		apply_pad(a);
