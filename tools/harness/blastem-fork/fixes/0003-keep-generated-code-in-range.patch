diff --git a/mem.c b/mem.c
index fb9a295..ae7fd1e 100644
--- a/mem.c
+++ b/mem.c
@@ -17,6 +17,10 @@
 #define MAP_ANONYMOUS MAP_ANON
 #endif
 
+#define MAX_CODE_DISTANCE ((ptrdiff_t)0x70000000)
+#define CODE_ALLOC_RETRY_STEP 0x1000000
+#define MAX_CODE_ALLOC_TRIES 32
+
 void * alloc_code(size_t *size)
 {
 	//start at 1GB above compiled code to allow plenty of room for sbrk based malloc implementations
@@ -29,10 +33,19 @@ void * alloc_code(size_t *size)
 	if (*size & (PAGE_SIZE -1)) {
 		*size += PAGE_SIZE - (*size & (PAGE_SIZE - 1));
 	}
-	ret = mmap(next, *size, PROT_EXEC | PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
-	if (ret == MAP_FAILED) {
-		perror("alloc_code");
-		return NULL;
+	//the address passed to mmap is only a hint, so check that the block is actually in range
+	for (int tries = 0; ; tries++) {
+		ret = mmap(next, *size, PROT_EXEC | PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+		if (ret == MAP_FAILED) {
+			perror("alloc_code");
+			return NULL;
+		}
+		ptrdiff_t distance = ret - (uint8_t *)alloc_code;
+		if (tries == MAX_CODE_ALLOC_TRIES || (distance < MAX_CODE_DISTANCE && distance > -MAX_CODE_DISTANCE)) {
+			break;
+		}
+		munmap(ret, *size);
+		next += CODE_ALLOC_RETRY_STEP;
 	}
 	track_block(ret);
 	next = ret + *size;
